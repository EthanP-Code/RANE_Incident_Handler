# Optional. Set these in .env or backend/.env for live inference.
# Google uses its model-specific generateContent endpoint automatically.
GEMMA_PROVIDER=google
GEMMA_API_KEY=
# Defaults to gemma-4-31b-it, verified against the configured Google key.
# GEMMA_MODEL=
# DigitalOcean requires its full HTTPS chat-completions URL and model ID.
# GEMMA_PROVIDER=digitalocean
# GEMMA_ENDPOINT=
# GEMMA_MODEL=

# Relative paths are resolved from the repository root when using run.py.
RANE_INCIDENTS_CSV=data/incident_event_log.csv
RANE_ACTIONS_DB=data/rane_actions.sqlite3
